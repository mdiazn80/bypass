{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bypass",
  "version": "0.1.1",
  "identifier": "com.mdiazn80.bypass",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bypass - Hosts Manager",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxQ0M3RUYyMjJGN0RGMzEKUldReDMvY2k4bjdNUVMvTWxDcFc0ditYREErbU9lTE1xajdDZ2xHcDJnRytNZGZmZExGU0Y1RDEK",
      "endpoints": [
        "https://github.com/mdiazn80/bypass/releases/latest/download/latest.json"
      ]
    }
  }
}
