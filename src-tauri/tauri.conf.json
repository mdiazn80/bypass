{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bypass",
  "mainBinaryName": "Bypass",
  "version": "26.11.1",
  "identifier": "com.mdiazn80.bypass",
  "build": {
    "beforeDevCommand": "cargo build -p bypass-shell && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bypass",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "devtools": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMDAyOTEwODMyOTAwMjUKUldRbEFDbURFQ2tBVFFTVm91aElWaUswcEhmanRZUS9iNXB0RDlkbXJWclAyMWVCSGp5bWQ5VWcK",
      "endpoints": [
        "https://github.com/mdiazn80/bypass/releases/latest/download/latest.json"
      ]
    }
  }
}
